# Host port -> Strata always listens on 8080 inside the container
PORT=8080

# Strata settings
MODEL=IQ2_XS
FAMILY=qwen
CONTEXT=32768
VISION=no
KV=int8

# Recommended if exposing Strata outside localhost
API_KEY=

# If you later change CONTEXT, VISION, KV, API_KEY, or other setup-time settings for an already configured model, run it with REINSTALL=1 temporarily
REINSTALL=0
